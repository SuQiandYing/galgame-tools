        const rootCandidate = findMainRoot(target);
        const knownRoot = !!(rootCandidate && rootCandidate.contains(slot));
        const root = rootCandidate || (slot.parentElement && slot.parentElement !== document.body ? slot.parentElement : document.body);
        if (!root || !slot.isConnected) return false;
        const slotRect = slot.getBoundingClientRect();
        if (slotRect.width === 0 || slotRect.height === 0) return true;
        const rootRect = root.getBoundingClientRect();
        // A fallback parent can have intentionally inherited gutters. Only
        // enforce the strict horizontal boundary when a semantic main root is
        // known; forbidden-region overlap is still checked in both cases.
        if (knownRoot && (slotRect.left < rootRect.left - 2 || slotRect.right > rootRect.right + 2)) return false;
        const forbidden = document.querySelectorAll('#left_menu, #right_menu, header, nav, aside, footer, [role="banner"], [role="navigation"], .navbar, .site-header, .global-header');
        for (const element of forbidden) {
            if (element === slot || slot.contains(element) || element.contains(slot)) continue;
            if (!isVisible(element)) continue;
            if (rectanglesOverlap(slotRect, element.getBoundingClientRect())) return false;
        }
        return true;
    }

    function relocateSlotToMainEnd(slot, target) {
        const root = findMainRoot(target) || (slot.parentElement && slot.parentElement !== document.body ? slot.parentElement : document.body);
        if (!root || isSidebarLike(root)) return false;
        const direct = directChildUnder(root, target);
        const sourceStyle = direct && window.getComputedStyle ? window.getComputedStyle(direct) : null;
        if (sourceStyle) {
            slot.style.setProperty('--cg-slot-margin-left', sourceStyle.marginLeft || '0px');
            slot.style.setProperty('--cg-slot-margin-right', sourceStyle.marginRight || '0px');
        }
        slot.style.setProperty('clear', 'both', 'important');
        if (root === target) {
            const parent = root.parentNode;
            if (!parent) return false;
            parent.insertBefore(slot, root.nextSibling);
        } else {
            root.appendChild(slot);
        }
        return slotLayoutIsSafe(slot, target);
    }

    function cleanupLegacyToolbars() {
        const currentSelector = `.cg-search-toolbar[data-cg-toolbar-version="${TOOLBAR_VERSION}"]`;
        const hasCurrentToolbar = !!document.querySelector(currentSelector);
        document.querySelectorAll('.cg-search-toolbar').forEach(toolbar => {
            if (toolbar.getAttribute('data-cg-toolbar-version') === TOOLBAR_VERSION) return;
            const parent = toolbar.parentElement;
            if (parent) {
                parent.querySelectorAll('[data-cg-added], [data-cg-deep-added]').forEach(node => {
                    node.removeAttribute('data-cg-added');
                    node.removeAttribute('data-cg-deep-added');
                });
            }
            toolbar.remove();
        });
        // Older copies may leave buttons outside the toolbar wrapper.
        document.querySelectorAll('[data-cg-btn]').forEach(button => {
            if (!button.closest(`.cg-search-toolbar[data-cg-toolbar-version="${TOOLBAR_VERSION}"]`)) button.remove();
        });
        document.querySelectorAll('.cg-search-slot').forEach(slot => {
            if (!slot.querySelector(currentSelector)) slot.remove();
        });
        if (!hasCurrentToolbar) {
            document.querySelectorAll('[data-cg-added], [data-cg-deep-added]').forEach(node => {
                node.removeAttribute('data-cg-added');
                node.removeAttribute('data-cg-deep-added');
            });
        }
    }

    function createToolbar(keyword, inline = false) {
        ensureUiStyles();
        const toolbar = document.createElement('div');
        toolbar.className = `cg-search-toolbar${inline ? ' cg-search-toolbar--inline' : ''}`;
        toolbar.setAttribute('role', 'group');
        toolbar.setAttribute('aria-label', '跨站搜索');
        toolbar.setAttribute('data-cg-toolbar', 'true');
        toolbar.setAttribute('data-cg-toolbar-version', TOOLBAR_VERSION);
        toolbar.setAttribute('data-cg-keyword', normalizeForMatch(keyword));
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'cg-search-toolbar__toggle';
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-controls', `cg-search-panel-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`);
        toggle.setAttribute('aria-label', '展开跨站搜索');
        toggle.title = '展开跨站搜索';
        toggle.textContent = '🔍 搜索';

        const panel = document.createElement('div');
        panel.className = 'cg-search-toolbar__panel';
        panel.id = toggle.getAttribute('aria-controls');
        panel.hidden = true;
        panel.setAttribute('role', 'group');
        panel.setAttribute('aria-label', '搜索站点');
        for (const type of ENGINE_ORDER) {
            if (shouldSkipEngine(type)) continue;
            const button = createBtn(keyword, type);
            if (button) panel.appendChild(button);
        }
        toggle.addEventListener('click', event => {
            event.preventDefault();
            event.stopPropagation();
            panel.hidden = !panel.hidden;
            const expanded = !panel.hidden;
            toggle.setAttribute('aria-expanded', String(expanded));
            toggle.setAttribute('aria-label', expanded ? '收起跨站搜索' : '展开跨站搜索');
            toggle.title = expanded ? '收起跨站搜索' : '展开跨站搜索';
            toggle.textContent = expanded ? '× 收起' : '🔍 搜索';
        });
        toolbar.appendChild(toggle);
        toolbar.appendChild(panel);
        return toolbar;
    }

    function attachToolbar(target, keyword, options = {}) {
        if (!isSafeToolbarTarget(target) || target.hasAttribute(options.marker || 'data-cg-added')) return false;
        // A page gets one shared entry bar. Dynamic result pages can replace
        // their title nodes repeatedly; without this guard each mutation
        // would create another bar before the previous node is observed.
        if (document.querySelector(`.cg-search-toolbar[data-cg-toolbar-version="${TOOLBAR_VERSION}"]`)) return false;
        const toolbar = createToolbar(keyword, !!options.inline);
        const panel = toolbar.querySelector('.cg-search-toolbar__panel');
        if (!panel || !panel.children.length) return false;
        if (options.highlight) {
            target.style.backgroundColor = 'rgba(255, 235, 59, .4)';
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        // Mount in a dedicated block after the title. The safety pass below
        // relocates it only when the host layout would overlap navigation or
        // a sidebar, so normal-flow pages retain their original structure.
        let slot = null;
        if (options.inline && (target.tagName === 'TR' || target.tagName === 'TD' || target.tagName === 'TH')) {
            const cell = target.tagName === 'TR' ? target.querySelector('td, th') : target;
            if (cell && !isSidebarLike(cell)) {
                slot = document.createElement('div');
                slot.className = 'cg-search-slot';
                slot.setAttribute('data-cg-slot', 'true');
                cell.appendChild(slot);
            }
        }
        if (!slot) slot = createSafeSlot(target, options);
        if (!slot) return false;
        if (!slotLayoutIsSafe(slot, target) && !relocateSlotToMainEnd(slot, target)) {
            slot.remove();
            return false;
        }
        slot.appendChild(toolbar);
        if (!slotLayoutIsSafe(slot, target) && !relocateSlotToMainEnd(slot, target)) {
            slot.remove();
            return false;
        }
        target.setAttribute(options.marker || 'data-cg-added', 'true');
        return true;
    }

    function getTitleItem(target, sources, fallback = '') {
        if (!isSafeToolbarTarget(target)) return null;
        const keyword = chooseTitle([...(sources || []), fallback]);
        return keyword ? { target, keyword } : null;
    }

    // DMM/FANZA has many non-product surfaces whose generic h1 is a section
    // label (library, account, navigation, etc.). Never mount the toolbar on
    // those pages; only product title nodes or an explicit search result may
    // provide a keyword.
    const DMM_UTILITY_PATH_RE = /(?:^|\/)(?:mylibrary|my-library|mypage|favorite|favorites|wishlist|cart|login|logout|register|signup|auth|help)(?:\/|$)/i;
    const DMM_PRODUCT_TITLE_SELECTOR = '#work_name, .productTitle__item--headline, .productTitle__txt, h1[data-e2e-title-in-product-detail], [data-testid*="product-title"], [data-testid*="work-name"], .product-title, .work_name';
    const DMM_PRODUCT_PATH_RE = /\/(?:dc\/[^/]+\/[-_]\/detail|detail|product|digital|mono)(?:\/|$)/i;

    function isDmmUtilityPage() {
        const path = location.pathname || '/';
        if (DMM_UTILITY_PATH_RE.test(path)) return true;
        return /\/dc\/[-_]\/mylibrary(?:\/|$)/i.test(path);
    }

    function getDmmProductTitle() {
        let target = document.querySelector(DMM_PRODUCT_TITLE_SELECTOR);
        if (!target && DMM_PRODUCT_PATH_RE.test(location.pathname || '')) {
            target = document.querySelector('#title, main h1, article h1');
        }
        if (!target || !isVisible(target)) return null;
        if (target.closest('header, nav, footer, .breadcrumb, .navigation, .menu')) return null;
        return target;
    }

    function isSafeToolbarTarget(target) {
        if (!target || target.nodeType !== 1) return false;
        if (target === document.body || target === document.documentElement) return false;
        const chrome = target.closest('header, nav, footer, [role="banner"], [role="navigation"], .navbar, .site-header, .global-header, .breadcrumb');
        // 2DFan reuses Bootstrap's `.navbar` class for the in-content title
        // strip (`.navbar.block-header`). It is normal flow content, not site
        // navigation, so keep it eligible while retaining the chrome guard.
        const isLegacyContentHeader = !!(chrome && chrome.classList && chrome.classList.contains('block-header') && !/^(?:HEADER|NAV|FOOTER)$/i.test(chrome.tagName || ''));
        if (chrome && !isLegacyContentHeader) return false;
        const style = window.getComputedStyle ? window.getComputedStyle(target) : null;
        if (style && (style.position === 'fixed' || style.position === 'sticky')) return false;
        return true;
    }

    function handleGoogleSearch() {
        if (!/^(?:www\.)?google\.[^/]+$/i.test(location.hostname)) return false;
        const rawQuery = new URLSearchParams(location.search).get('q') || '';
        const site = /site:(seiya-saiga\.com|sagaoz\.net)/i.exec(rawQuery);
        if (!site) return false;
        const query = rawQuery.replace(/site:(?:seiya-saiga\.com|sagaoz\.net)/ig, ' ').replace(/\s+/g, ' ').trim();
        if (normalizeForMatch(query).length < MIN_FINGER_LENGTH) return false;
        const allowedHost = site[1].toLowerCase();
        const anchors = Array.from(document.querySelectorAll('a[href]')).filter(anchor => {
            try { return new URL(anchor.href).hostname.endsWith(allowedHost); } catch { return false; }
        });
        const match = findBestMatch(anchors, query, .56);
        if (!match) return false;
        try {
            const targetUrl = new URL(match.element.href);
            targetUrl.searchParams.set('cgsearch', query);
            if (targetUrl.href !== location.href) location.replace(targetUrl.href);
            return true;
        } catch {
            return false;
        }
    }

    function handleSeiyaLogic() {
        if (!/seiya-saiga\.com$|sagaoz\.net$/i.test(location.hostname)) return false;
        const searchRaw = new URLSearchParams(location.search).get('cgsearch');
        if (!searchRaw || normalizeForMatch(searchRaw).length < MIN_FINGER_LENGTH) return false;

        if (/save\.html/i.test(location.pathname)) {
            const match = findBestMatch(Array.from(document.querySelectorAll('tr, .save-list li, .game-list li')), searchRaw, .58);
            if (match) attachToolbar(match.element.querySelector('td[align="left"], .title, .name') || match.element, searchRaw, { inline: true, marker: 'data-cg-deep-added', highlight: true });
            return false;
        }

        if (/(?:kouryaku\.html|galge\.html|\/game\.html$)/i.test(location.pathname)) {
            const links = Array.from(document.querySelectorAll('a[href]')).filter(link => /\.html(?:[?#]|$)/i.test(link.getAttribute('href') || ''));
            const match = findBestMatch(links, searchRaw, .58);
            if (match) {
                try {
                    const targetUrl = new URL(match.element.href);
                    targetUrl.searchParams.set('cgsearch', searchRaw);
                    if (targetUrl.href !== location.href) location.replace(targetUrl.href);
                    return true;
                } catch { /* ignore malformed legacy links */ }
            }
            if (/sagaoz\.net$/i.test(location.hostname)) return false;
            location.replace(`https://www.google.com/search?q=${encodeURIComponent(`site:seiya-saiga.com ${searchRaw}`)}`);
            return true;
        }

        const candidates = Array.from(document.querySelectorAll('h1, h2, h3, .title, .name, td[align="left"]'));
        const match = findBestMatch(candidates, searchRaw, .62);
        if (match) attachToolbar(match.element, searchRaw, { inline: true, marker: 'data-cg-deep-added', highlight: true });
        return false;
    }

    const SITES = [
        {
            name: 'VNDB',
            check: () => /(?:^|\.)vndb\.org$/i.test(location.hostname) && /^\/v\d+/i.test(location.pathname),
            run: () => {
                const target = document.querySelector('h1.vn-title, h1#page-title') || findContentHeading('main h1, article h1');
                const jp = findVndbJapaneseTitle();
                // Keep the title heading as the mount point, but always use
                // the explicit Japanese alternate title when VNDB provides it.
                return getTitleItem(target || jp, [jp, target, ...getMetaTitle()]);
            }
        },
        {
            name: 'MoYu',
            check: () => /(?:^|\.)moyu\.moe$/i.test(location.hostname) && /^(?:\/(?:patch|resource|galgame|game|search))(?:\/|$)/i.test(location.pathname),
            run: () => {
                const target = findContentHeading('h1, .work-title, article h2');
                const query = getQueryKeyword(['q', 'keyword', 's']);
                if (query) return getTitleItem(target || findContentMount(), [query]);
                // `[lang="ja"]` also matches the document root on Moyu and
                // therefore contributes the entire page text. Only inspect a
                // title-bearing node; the explicit heading is the authority.
                return getTitleItem(target, [target, document.querySelector('h1[lang="ja"], [data-original-title]'), ...getMetaTitle()]);
            }
        },
        {
            name: 'Ai2',
            check: () => /(?:^|\.)ai2\.moe$/i.test(location.hostname),
            run: () => {
                const target = findContentHeading('h1.ipsType_pageTitle, .ipsPageHeader h1, h1');
                const query = getQueryKeyword(['q', 'keyword']);
                return getTitleItem(target || findContentMount(), [query, target, ...getMetaTitle()]);
            }
        },
        {
            name: '2DFan',
            check: () => /(?:2dfan|2dfdf|2dfmax|fan2d|galge)\.(?:com|de|top)$/i.test(location.hostname),
            run: () => {
                const path = location.pathname || '/';
                const input = document.querySelector('input[name="keyword"], input[name="q"], input[type="search"]');
                const query = getQueryKeyword(['keyword', 'q']);

                // Modern 2DFan has a site-name h3 followed by the actual
                // result/detail heading. Keep the search query as the source
                // on result pages so `_2DFan` and page chrome never leak in.
                if (/\/subjects\/search(?:\/|$)/i.test(path)) {
                    if (!query) return null;
                    const resultTitle = findContentHeading('#content h4.media-heading, #content h4, h4.media-heading, .subject-title, .game-title');
                    const searchMount = input && (input.closest('form') || input.parentElement);
                    return getTitleItem(resultTitle || searchMount || document.querySelector('#content') || findContentMount(), [query]);
                }

                if (/\/subjects\/\d+(?:\/|$)/i.test(path)) {
                    const title = findContentHeading('#content h3, h3.subject-title, .subject-title, .game-title, h1, h2');
                    return getTitleItem(title, [title]);
                }

                // Preserve support for the older alias domains while avoiding
                // the `site-name` heading and metadata-only fallbacks.
                const target = findContentHeading('#content h3, h1, h2, h3.subject-title, .subject-title, .game-title, .title');
                if (!target) return query ? getTitleItem(input && (input.closest('form') || input.parentElement), [query]) : null;
                return getTitleItem(target, [query, target]);
            }
        },
        {
            name: 'Bangumi',
            check: () => /^(?:www\.)?(?:bgm|bangumi)\.tv$|^(?:www\.)?chii\.in$/i.test(location.hostname),
            run: () => {
                if (/^\/subject\/\d+/i.test(location.pathname)) {
                    const target = findContentHeading('h1.nameSingle, #headerSubject h1, h1');
                    return getTitleItem(target, [target, document.querySelector('#subject_inner_info [lang="ja"]'), ...getMetaTitle()]);
                }
                if (/^\/subject_search(?:\/|$)/i.test(location.pathname)) {
                    const input = document.querySelector('#search_text, input[name="search_text"], input[name="keyword"], input[type="search"]');
                    const query = getQueryKeyword(['q', 'keyword']) || getPathKeyword('/subject_search/');
                    return query ? getTitleItem(input && (input.closest('form') || input.parentElement) || findContentMount(), [query]) : null;
                }
                return null;
            }
        },
        {
            name: 'DLsite',
            check: () => /(?:^|\.)dlsite\.com$/i.test(location.hostname),
            run: () => {
                const productTarget = document.querySelector('#work_name, .productTitle__txt, .work_name');
                const query = getQueryKeyword(['keyword', 'q', 'word']) || getPathKeyword('/pro/fsr/=/keyword/');
                if (productTarget) return getTitleItem(productTarget, [query, productTarget, ...getMetaTitle()]);
                if (!query || !/\/pro\/fsr\/=\/keyword\//i.test(location.pathname)) return null;
                const searchTarget = document.querySelector('#base_title_br, .base_title_br, #search_result_list, #main_inner, #main');
                return getTitleItem(searchTarget || findContentMount(), [query]);
            }
        },
        {
            name: 'DMM',
            check: () => /dmm\.(?:co\.jp|com)$/i.test(location.hostname),
            run: () => {
                if (isDmmUtilityPage()) return null;
                const target = getDmmProductTitle();
                const query = getQueryKeyword(['searchstr', 'keyword', 'q']) || getPathKeyword('/search/=/searchstr=');
                if (!target && !query) return null;
                if (target) return getTitleItem(target, [query, target, ...getMetaTitle()]);
                const searchTarget = document.querySelector('.search_result_title, .search-result, [data-search-result], form[role="search"]');
                return searchTarget ? getTitleItem(searchTarget, [query]) : null;
            }
        },
        {
            name: 'ErogameScape',
            check: () => /(?:^|\.)(?:erogamescape\.org|erogamescape\.dyndns\.org)$|(?:^|\.)koko\.kyara\.top$/i.test(location.hostname),
            run: () => {
                if (/kensaku\.php/i.test(location.pathname)) {
                    const query = getQueryKeyword(['word', 'q', 'keyword']);
                    if (!query) return null;
                    const resultTitle = document.querySelector('#main h2, main h2, .search-result-title, .results-title');
                    return getTitleItem(resultTitle || findContentMount(), [query]);
                }
                const title = document.querySelector('#game_title, .game-title, .work-title');
                const mount = document.querySelector('#soft-title') || title;
                if (!mount) return null;
                return getTitleItem(mount, [title && (title.querySelector('a') || title), mount, ...getMetaTitle()]);
            }
        },
        {
            name: 'Moepedia',
            check: () => /(?:^|\.)moepedia\.net$/i.test(location.hostname) && /^\/game\/[^/]+/i.test(location.pathname),
            run: () => {
                const target = findContentHeading('h1, h2, .entry-title, .post-title, .game-title');
                return getTitleItem(target, [target, ...getMetaTitle()]);
            }
        },
        {
            name: 'Sagaoz',
            check: () => /(?:^|\.)sagaoz\.net$/i.test(location.hostname) && !/\/game\.html$/i.test(location.pathname),
            run: () => {
                const target = findContentHeading('h1, caption, td[bgcolor="#ccffcc"] b, div[align="center"] b font[size="5"]');
                return getTitleItem(target, [target, ...getMetaTitle()]);
            }
        },
        {
            name: 'VGMdb',
            check: () => /(?:^|\.)vgmdb\.net$/i.test(location.hostname) && /\/(?:album|product|artist)\//i.test(location.pathname),
            run: () => {
                const target = findContentHeading('h1, .albumtitle, .product-title');
                return getTitleItem(target, [target && target.querySelector('[lang="ja"]'), target, ...getMetaTitle()]);
            }
        },
        {
            name: 'Hitomi',
            check: () => /(?:^|\.)hitomi\.la$/i.test(location.hostname),
            run: () => {
                const target = findContentHeading('#gallery-title, .gallery-title, h1, h2');
                let query = getQueryKeyword(['q', 'keyword']);
                if (!query && /\/search\.html$/i.test(location.pathname) && location.search.length > 1) {
                    try {
                        const raw = decodeURIComponent(location.search.slice(1).replace(/\+/g, ' '));
                        if (isLikelyGameTitle(raw)) query = cleanGameTitle(raw);
                    } catch { /* ignore malformed search text */ }
                }
                return getTitleItem(target || findContentMount(), [query, target, ...getMetaTitle()]);
            }
        },
        {
            name: 'EH',
            check: () => /(?:^|\.)(?:e-hentai|exhentai)\.org$/i.test(location.hostname),
            run: () => {
                const target = findContentHeading('#gn, #gallery-front h1, .gm h1, h1');
                const query = getQueryKeyword(['f_search', 'q']);
                return getTitleItem(target || findContentMount(), [query, target, ...getMetaTitle()]);
            }
        },
        {
            name: 'Moonchan',
            check: () => /(?:^|\.)ex\.moonchan\.xyz$/i.test(location.hostname),
            run: () => {
                const target = findContentHeading('h1, h2, .title, .name');
                const query = getQueryKeyword(['f_search', 'q', 'keyword']);
                return getTitleItem(target || findContentMount(), [query, target, ...getMetaTitle()]);
            }
        },
        {
            name: 'GGbase',
            check: () => /(?:^|\.)ggbases\.dlgal\.com$/i.test(location.hostname),
            run: () => {
                const target = findContentHeading('h1, .game-title, .subject-title, .title');
                const query = getQueryKeyword(['title', 'q', 'keyword']);
                return getTitleItem(target || findContentMount(), [query, target, ...getMetaTitle()]);
            }
        },
        {
            name: 'Nyaa',
            check: () => /(?:^|\.)sukebei\.nyaa\.si$/i.test(location.hostname),
            run: () => {
                const target = findContentHeading('h1, .torrent-title, .view tbody tr:first-child td');
                const query = getQueryKeyword(['q', 'keyword']);
                if (!query) return null;
                return getTitleItem(target || findContentMount(), [query, target]);
            }
        },
        {
            name: 'Bishogedb',
            check: () => /^(?:www\.)?bishogedb\.com$/i.test(location.hostname),
            run: () => {
                if (/^\/item\/[^/]+/i.test(location.pathname)) {
                    const title = document.querySelector('.detail-title, .hero-title-block h1');
                    const target = title?.closest('.hero-title-block') || title;
                    return getTitleItem(target, [title, ...getMetaTitle()]);
                }
                if (/^\/search(?:\/|$)/i.test(location.pathname)) {
                    const query = getQueryKeyword(['q']);
                    if (!query) return null;
                    const target = document.querySelector('.search-view .view-title, .search-view h1, .view-title');
                    return getTitleItem(target, [query]);
                }
                return null;
            }
        },
        {
            name: 'Seiya',
            check: () => /(?:^|\.)seiya-saiga\.com$/i.test(location.hostname) && !/(?:kouryaku\.html|galge\.html|save\.html)/i.test(location.pathname),
            run: () => {
                const target = findContentHeading('h1, h2, .game-title, .title, th[height="50"] font[size="5"], th font[size="5"]');
                const query = getQueryKeyword(['cgsearch']);
                return getTitleItem(target || findContentMount(), [query, target, ...getMetaTitle()]);
            }
        }
    ];

    function main() {
        if (!document.body) return;
        ensureUiStyles();
        cleanupLegacyToolbars();
        if (handleGoogleSearch()) return;
        if (handleSeiyaLogic()) return;
        const site = SITES.find(candidate => candidate.check());
        if (!site) return;
        let item;
        try { item = site.run(); } catch { return; }
        if (!item || !item.target || item.target.hasAttribute('data-cg-added')) return;
        if (!isLikelyGameTitle(item.keyword)) return;
        attachToolbar(item.target, item.keyword, { before: site.name === 'VNDB' });
    }

    let scheduled = false;
    function scheduleMain() {
        if (scheduled) return;
        scheduled = true;
        const run = () => { scheduled = false; main(); };
        if (typeof requestAnimationFrame === 'function') requestAnimationFrame(run);
        else setTimeout(run, 80);
    }

    if (document.body && typeof MutationObserver !== 'undefined') {
        const observer = new MutationObserver(scheduleMain);
        observer.observe(document.body, { childList: true, subtree: true });
    }
    window.addEventListener('popstate', scheduleMain);
    window.addEventListener('hashchange', scheduleMain);
    main();
})();
